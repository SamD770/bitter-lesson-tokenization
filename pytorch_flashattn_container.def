Bootstrap: docker
From: pytorch/pytorch:2.7.0-cuda12.6-cudnn9-devel

%post
    # Additional setup if needed
    # Use /tmp inside container (it already exists)
    export TMPDIR=/tmp
    export PIP_CACHE_DIR=/tmp/pip_cache
    mkdir -p $PIP_CACHE_DIR
    
    export CUDA_HOME="/usr/local/cuda"
    apt-get update && apt-get install -y --no-install-recommends git
    pip3 install --no-cache-dir --upgrade pip
    pip3 install packaging
    pip3 install ninja
    pip3 install --no-cache-dir flash-attn --no-build-isolation
    pip3 install transformers
    pip3 install datasets
    pip3 install --no-cache-dir mamba-ssm --no-build-isolation

%environment
    export LC_ALL=C
    export CUDA_HOME="/usr/local/cuda"


%runscript
    python --version
    echo "To run your script, use: apptainer exec pytorch_container.sif python /path/to/your/script.py"
